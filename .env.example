PAYSTACK_SECRET_KEY=
VITE_PAYSTACK_PUBLIC_KEY=

SUPABASE_PROJECT_ID=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# Optional Next-style aliases (also read by src/lib/supabase-client.ts)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

VTPASS_API_KEY=
VTPASS_BASE_URL=
VTPASS_MODE=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=

# Optional fallback only — leave disabled until you subscribe and verify it.
VTUAFRICA_ENABLED=false
VTUAFRICA_API_KEY=
VTUAFRICA_MODE=sandbox

# Dojah (server only — never expose secret to the browser)
DOJAH_SECRET_KEY=
DOJAH_APP_ID=
DOJAH_MODE=sandbox
# DOJAH_BASE_URL=https://sandbox.dojah.io

# Hub: allow demo pay references without Paystack verify (dev only)
HUB_ALLOW_UNVERIFIED_PAY=false
