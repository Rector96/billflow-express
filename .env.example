# =============================================================================
# BillFlow Express — environment template
# Copy to .env and fill in values. NEVER commit .env.
# Full guide: EXTERNAL_SUPABASE_SETUP.md
# =============================================================================

# --- Supabase (your own project, not Lovable Cloud) ---
# Dashboard → Project Settings → API

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Publishable / anon key (legacy JWT or sb_publishable_...)
# Same value for server + client is correct.
SUPABASE_PUBLISHABLE_KEY=your_anon_or_sb_publishable_key
VITE_SUPABASE_PUBLISHABLE_KEY=your_anon_or_sb_publishable_key

# Optional: project ref (the subdomain part of the URL)
SUPABASE_PROJECT_ID=YOUR_PROJECT_REF
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Server ONLY — never expose to the browser or Vite public env
# service_role JWT or sb_secret_...
SUPABASE_SERVICE_ROLE_KEY=your_service_role_or_sb_secret_key

# --- Paystack (TEST mode) ---
# Dashboard → Settings → API Keys → Secret Key (sk_test_...)
# Live keys (sk_live_...) are rejected by this app on purpose.
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxx
